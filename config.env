#!/bin/bash
# Inferno Automation Configuration
# Edit these variables before running setup.sh

# Device & Firmware
DEVICE="n104ap"
DEVICE_FULL="iPhone12,1"
BOARD="t8030"
SEP_ROM_NAME="AppleSEPROM-Cebu-B1"

# IPSW - download URL and filename
IPSW_URL="https://updates.cdn-apple.com/2020SummerSeed/fullrestores/001-35886/5FE9BE2E-17F8-41C8-96BB-B76E2B225888/iPhone11,8,iPhone12,1_14.0_18A5351d_Restore.ipsw"
IPSW_FILENAME="iPhone11,8,iPhone12,1_14.0_18A5351d_Restore.ipsw"

# SEP Firmware IV+Key (concatenated, no spaces)
# Get from https://theapplewiki.com
SEP_IV_KEY=""

# RAM Disk for initrd (Erase = smaller, Upgrade = larger)
RAM_DISK="038-44135-124.dmg"

# AP ticket SHSH URL
TICKET_SHSH_URL="https://chefkiss.dev/Extras/Inferno/ticket.shsh2"

# Number of CPU cores & RAM for main VM
MAIN_SMP=7
MAIN_RAM="4G"

# Companion VM settings
COMPANION_RAM="2G"
COMPANION_SMP=2
COMPANION_SSH_PORT=32222
COMPANION_USER="root"
COMPANION_PASS="root"

# SEP ROM download URL (from https://securerom.fun)
SEP_ROM_URL=""
