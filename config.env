#!/bin/bash
# Inferno Automation Configuration
# Edit these variables before running setup.sh
# NOTE: tuned for the current Inferno checkout (xmake build, t8030).

# --- Emulated device -------------------------------------------------------
BOARD="t8030"
ECID="0x1122334455667788"
KASLR_OFF="true"
MAIN_SMP=7
MAIN_RAM="4G"
# Current Inferno has no gtk/sdl UI on Linux; the official guide runs
# headless with -serial mon:stdio. Set e.g. "curses" if your build supports it.
DISPLAY_ARGS=""
KERNEL_ARGS="tlto_us=-1 mtxspin=-1 agm-genuine=1 agm-authentic=1 agm-trusted=1 serial=3 wdt=-1 -vm_compressor_wk_sw"

# --- SEP ROM ---------------------------------------------------------------
# Must be the Cebu B1 ROM for t8030. Put the file in InfernoData/, or set
# SEP_ROM_URL below and setup.sh will download it.
SEP_ROM_NAME="AppleSEPROM-Cebu-B1"
# Direct dump from https://securerom.fun (Apple A13 / Cebu B1)
SEP_ROM_URL="https://securerom.fun/resources/SEPROM/AppleSEPROM-Cebu-B1"

# --- IPSW ------------------------------------------------------------------
# iOS 14.0 18A5351d (iPhone 11 / XR). You can replace with any supported IPSW.
IPSW_URL="https://updates.cdn-apple.com/2020SummerSeed/fullrestores/001-35886/5FE9BE2E-17F8-41C8-96BB-B76E2B225888/iPhone11,8,iPhone12,1_14.0_18A5351d_Restore.ipsw"
IPSW_FILENAME="iPhone11,8,iPhone12,1_14.0_18A5351d_Restore.ipsw"

# IV+Key for the SEP firmware of the IPSW above (concatenated, no spaces).
# Source: https://theapplewiki.com/wiki/Keys:AzulSeed_18A5351d_(iPhone12,1)
# Used by: ./run.sh restore
SEP_IV_KEY="017a328b048aab2edcc4cfe043c2d844a55e67143d57938e37ec6b83ba9e181c0d24bd0a6a14f9f39752b967a9c45cfc"

# --- Local services --------------------------------------------------------
# SimulatedSigningServer (SSS) address. Inferno's VirtualHere USB uplink uses
# 127.0.0.1:8030 by default; SSS listens on 8031.
SSS_HOST="127.0.0.1"
SSS_PORT=8031

# --- Optional paths --------------------------------------------------------
# Where local build tools (xmake fallback, lzfse, idevicerestore) are installed.
# Leave empty to use <repo>/.local
LOCAL_PREFIX=""
# Number of parallel build jobs. Empty = nproc
JOBS=""
