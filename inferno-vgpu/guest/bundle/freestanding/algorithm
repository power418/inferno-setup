#pragma once
namespace std {
template <typename T>
inline const T& min(const T& a, const T& b) { return (a < b) ? a : b; }
template <typename T>
inline T&& move(T& x) { return static_cast<T&&>(x); }
template <typename T>
inline void swap(T& a, T& b) { T t = static_cast<T&&>(a); a = static_cast<T&&>(b); b = static_cast<T&&>(t); }
}
